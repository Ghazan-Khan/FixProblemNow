# Copy to .env and fill in only the channels you intend to use.
# This file is documentation; it is not loaded automatically by Astro.
# Set these variables in your hosting provider for production.

# Canonical origin used at build time for canonicals, JSON-LD, Open Graph and
# the XML sitemap. Include the scheme, without a trailing slash.
SITE_URL=https://fixproblemnow.com

# --- Contact form: email delivery through Resend -------------------------
# The email channel is used when all three values below are present.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# --- Contact form: generic webhook fallback ------------------------------
# Used only when the Resend email channel is not fully configured.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=

# --- Guide feedback ------------------------------------------------------
# If the webhook is set, feedback is posted there. Otherwise it is appended
# to FEEDBACK_LOG_DIR/feedback.jsonl, which requires a persistent filesystem.
FEEDBACK_WEBHOOK_URL=
FEEDBACK_WEBHOOK_SECRET=
FEEDBACK_LOG_DIR=

# --- Node standalone server ---------------------------------------------
HOST=0.0.0.0
PORT=4321

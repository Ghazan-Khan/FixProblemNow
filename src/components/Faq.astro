---
import Icon from './Icon.astro';

interface Props {
  items: { q: string; a: string }[];
}

const { items } = Astro.props;
---

<div class="faq-list">
  {items.map((item) => (
    <details class="faq">
      <summary>
        {item.q}
        <Icon name="plus" size={18} />
      </summary>
      <div class="faq__body">
        <p>{item.a}</p>
      </div>
    </details>
  ))}
</div>

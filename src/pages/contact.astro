---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import { breadcrumbSchema, webPageSchema } from '../lib/schema';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Contact', href: '/contact/' },
];

const schemas = [
  breadcrumbSchema(crumbs),
  webPageSchema(
    'Contact FixProblemNow',
    'Send a correction, accessibility report, privacy question or general message to FixProblemNow.',
    '/contact/',
    { type: 'ContactPage' },
  ),
];
---

<BaseLayout
  title="Contact FixProblemNow"
  description="Report a guide error, an accessibility problem, a privacy question, or send general feedback. This is not a live support channel."
  canonical="/contact/"
  jsonLd={schemas}
>
  <header class="content-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">Contact</p>
      <h1>Send a correction or a message</h1>
      <p>
        Use this form for guide corrections, accessibility problems, privacy questions, or general
        feedback. It is not a live support channel, and we cannot remotely diagnose a device.
      </p>
    </div>
  </header>

  <div class="container contact-layout">
    <div>
      <div class="form-status form-status--info" role="status" data-delivery-status hidden></div>

      <form class="form" novalidate data-contact-form>
        <input type="hidden" name="startedAt" value="" data-started-at />
        <div class="hp-field" aria-hidden="true">
          <label for="contact-website">Website</label>
          <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="form-row">
          <div class="field">
            <label for="contact-name">Your name</label>
            <input id="contact-name" name="name" type="text" autocomplete="name" required maxlength="80" aria-describedby="name-error" />
            <span class="field__error" id="name-error" data-error-for="name" hidden></span>
          </div>
          <div class="field">
            <label for="contact-email">Email address</label>
            <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="email-error email-help" />
            <span class="field__help" id="email-help">Used only to reply to this message.</span>
            <span class="field__error" id="email-error" data-error-for="email" hidden></span>
          </div>
        </div>

        <div class="field">
          <label for="contact-topic">What is this about?</label>
          <select id="contact-topic" name="topic" required aria-describedby="topic-error">
            <option value="general">General question or feedback</option>
            <option value="guide-feedback">Guide feedback or a suggested improvement</option>
            <option value="correction">A factual correction</option>
            <option value="accessibility">An accessibility problem</option>
            <option value="privacy">A privacy question</option>
            <option value="partnership">A partnership or media question</option>
          </select>
          <span class="field__error" id="topic-error" data-error-for="topic" hidden></span>
        </div>

        <div class="field">
          <label for="contact-guide">Guide URL or title <span class="optional">(optional)</span></label>
          <input id="contact-guide" name="guide" type="text" maxlength="160" placeholder="e.g. /printer-problems/printer-offline/" />
          <span class="field__help">Include this if your message is about a specific guide.</span>
        </div>

        <div class="field">
          <label for="contact-message">Your message</label>
          <textarea id="contact-message" name="message" required minlength="20" maxlength="5000" aria-describedby="message-help message-error" data-message></textarea>
          <span class="field__help" id="message-help">
            For a correction, include the device model, software version, and the wording that needs
            changing. Do not include passwords, recovery codes, or payment details.
            <span data-character-count></span>
          </span>
          <span class="field__error" id="message-error" data-error-for="message" hidden></span>
        </div>

        <label class="checkbox">
          <input type="checkbox" name="acknowledge" required data-acknowledge />
          <span>
            I understand this is not a live support service and that no reply time is guaranteed.
            I have not included a password, one-time code, recovery key, or payment details.
          </span>
        </label>
        <span class="field__error" data-error-for="acknowledge" hidden></span>

        <div class="form-note">
          <p>
            Messages are delivered to the site team through the configured email or webhook
            service. If delivery is not configured on this deployment, the form will say so and no
            message will be sent. Read the <a href="/privacy-policy/">privacy policy</a> for how
            contact details are handled.
          </p>
        </div>

        <div>
          <button class="btn btn--primary" type="submit" data-submit>
            Send message
            <Icon name="arrow-right" size={16} />
          </button>
        </div>

        <p class="form-status" role="status" aria-live="polite" data-form-status hidden></p>
      </form>
    </div>

    <aside class="contact-aside">
      <h2>What to include</h2>
      <ul>
        <li>The guide URL, if your message is about a guide.</li>
        <li>The device model and software version.</li>
        <li>The exact error message or step that failed.</li>
        <li>What you tried before contacting us.</li>
      </ul>
      <h3>What not to send</h3>
      <ul>
        <li>Passwords, PINs, or one-time verification codes.</li>
        <li>Recovery keys or full card numbers.</li>
        <li>Screenshots containing personal or financial information.</li>
      </ul>
      <h3>Need device help now?</h3>
      <p>
        Browse the <a href="/problems/">guide library</a> or use
        <a href="/search/">search</a>. For repairs, account recovery, or urgent safety issues, see
        <a href="/get-help/">get additional help</a>.
      </p>
      <h3>Accessibility</h3>
      <p>
        If part of the site is difficult to use with your assistive technology, choose
        “An accessibility problem” above and describe the page and the barrier.
      </p>
    </aside>
  </div>
</BaseLayout>

<script>
  import { site } from '../data/site';

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const startedAt = document.querySelector<HTMLInputElement>('[data-started-at]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');
  const deliveryStatus = document.querySelector<HTMLElement>('[data-delivery-status]');
  const submit = document.querySelector<HTMLButtonElement>('[data-submit]');
  const message = document.querySelector<HTMLTextAreaElement>('[data-message]');
  const counter = document.querySelector<HTMLElement>('[data-character-count]');

  if (startedAt) startedAt.value = String(Date.now());

  const params = new URLSearchParams(window.location.search);
  const topicParam = params.get('topic');
  const guideParam = params.get('guide');
  if (topicParam === 'guide') {
    const topic = document.querySelector<HTMLSelectElement>('#contact-topic');
    if (topic) topic.value = 'guide-feedback';
  } else if (topicParam && document.querySelector<HTMLSelectElement>('#contact-topic')) {
    const topic = document.querySelector<HTMLSelectElement>('#contact-topic');
    const option = [...(topic?.options ?? [])].find((item) => item.value === topicParam);
    if (option && topic) topic.value = topicParam;
  }
  if (guideParam) {
    const guide = document.querySelector<HTMLInputElement>('#contact-guide');
    if (guide) guide.value = guideParam;
  }

  const updateCounter = () => {
    if (counter && message) {
      counter.textContent = ` ${message.value.length} of 5000 characters.`;
    }
  };
  message?.addEventListener('input', updateCounter);
  updateCounter();

  fetch(site.contact.endpoint, { headers: { Accept: 'application/json' } })
    .then((response) => (response.ok ? response.json() : null))
    .then((data: { configured?: boolean } | null) => {
      if (!deliveryStatus) return;
      if (data && data.configured === false) {
        deliveryStatus.className = 'form-status form-status--info';
        deliveryStatus.textContent =
          'This deployment has not been configured to deliver contact messages. You can still complete the form, but it will tell you that no message was sent.';
        deliveryStatus.hidden = false;
      }
    })
    .catch(() => {
      // The form remains usable; the POST result is the source of truth.
    });

  const setError = (field: string, messageText: string) => {
    const target = form?.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
    if (target) {
      target.textContent = messageText;
      target.hidden = false;
    }
    const input = form?.querySelector<HTMLElement>(`[name="${field}"]`);
    input?.setAttribute('aria-invalid', 'true');
  };

  const clearErrors = () => {
    form?.querySelectorAll<HTMLElement>('[data-error-for]').forEach((target) => {
      target.textContent = '';
      target.hidden = true;
    });
    form?.querySelectorAll<HTMLElement>('[aria-invalid="true"]').forEach((input) =>
      input.removeAttribute('aria-invalid'),
    );
  };

  const validate = (): boolean => {
    if (!form) return false;
    clearErrors();
    let firstInvalid: HTMLElement | null = null;

    const name = form.querySelector<HTMLInputElement>('[name="name"]');
    const email = form.querySelector<HTMLInputElement>('[name="email"]');
    const topic = form.querySelector<HTMLSelectElement>('[name="topic"]');
    const messageField = form.querySelector<HTMLTextAreaElement>('[name="message"]');
    const acknowledge = form.querySelector<HTMLInputElement>('[data-acknowledge]');

    if (!name || name.value.trim().length < 2) {
      setError('name', 'Enter your name (at least 2 characters).');
      firstInvalid ??= name;
    }
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email.value.trim())) {
      setError('email', 'Enter a valid email address.');
      firstInvalid ??= email;
    }
    if (!topic || !topic.value) {
      setError('topic', 'Choose a topic.');
      firstInvalid ??= topic;
    }
    if (!messageField || messageField.value.trim().length < 20) {
      setError('message', 'Please describe the issue in at least 20 characters.');
      firstInvalid ??= messageField;
    }
    if (!acknowledge || !acknowledge.checked) {
      setError('acknowledge', 'Please confirm that you have read this note.');
      firstInvalid ??= acknowledge;
    }

    if (firstInvalid) {
      firstInvalid.focus();
      return false;
    }
    return true;
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!validate()) return;

    if (status) {
      status.hidden = true;
      status.className = 'form-status';
    }
    if (submit) {
      submit.disabled = true;
      submit.setAttribute('aria-busy', 'true');
    }

    const data = new FormData(form!);
    const payload = {
      name: String(data.get('name') ?? ''),
      email: String(data.get('email') ?? ''),
      topic: String(data.get('topic') ?? ''),
      guide: String(data.get('guide') ?? ''),
      message: String(data.get('message') ?? ''),
      website: String(data.get('website') ?? ''),
      startedAt: Number(data.get('startedAt') ?? 0),
    };

    try {
      const response = await fetch(site.contact.endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = (await response.json().catch(() => ({}))) as {
        ok?: boolean;
        message?: string;
        error?: string;
        errors?: Record<string, string>;
      };

      if (!response.ok || !result.ok) {
        if (result.errors) {
          Object.entries(result.errors).forEach(([field, messageText]) => setError(field, messageText));
        }
        if (status) {
          status.className = 'form-status form-status--error';
          status.textContent =
            result.error ??
            'The message could not be sent. No confirmation was received, so please assume it was not delivered.';
          status.hidden = false;
        }
        return;
      }

      if (status) {
        status.className = 'form-status form-status--success';
        status.textContent =
          result.message ??
          'Your message was delivered to the site team. Keep a copy if it contains important details.';
        status.hidden = false;
      }
      form?.reset();
      if (startedAt) startedAt.value = String(Date.now());
      clearErrors();
      updateCounter();
      status?.focus?.();
    } catch {
      if (status) {
        status.className = 'form-status form-status--error';
        status.textContent =
          'A network error stopped the message from being sent. No confirmation was received, so please assume it was not delivered.';
        status.hidden = false;
      }
    } finally {
      if (submit) {
        submit.disabled = false;
        submit.removeAttribute('aria-busy');
      }
    }
  });
</script>
